<section class="s-hero s-hero--photo-overlay" data-section-id="{{id}}" aria-labelledby="hero-title-{{id}}">
  <div class="s-media">
    {{#image_src}}<img src="{{image_src}}" alt="{{image_alt}}">{{#image_ai_badge}}<span class="s-illu-badge">AI 예시 이미지</span>{{/image_ai_badge}}{{/image_src}}
    {{^image_src}}<div class="s-media__empty is-placeholder" aria-label="사진: 아직 입력되지 않음">[사진 입력]</div>{{/image_src}}
  </div>
  <div class="s-hero__body">
    <h1 class="s-title" id="hero-title-{{id}}">
      {{#title}}{{title}}{{/title}}{{^title}}<span class="is-placeholder" aria-label="가게 이름: 아직 입력되지 않음">[가게 이름 입력]</span>{{/title}}
    </h1>
    <p class="s-lead">
      {{#subtitle}}{{subtitle}}{{/subtitle}}{{^subtitle}}<span class="is-placeholder" aria-label="소개 한 줄: 아직 입력되지 않음">[소개 한 줄 입력]</span>{{/subtitle}}
    </p>
    {{#has_facts}}<ul class="s-hero__facts">{{#facts}}<li><span class="s-hero__fact-label">{{label}}</span> {{value}}</li>{{/facts}}</ul>{{/has_facts}}
    {{#cta_label}}<p class="s-hero__cta"><a class="s-btn" href="{{cta_href}}">{{cta_label}}</a>{{#cta2_label}}<a class="s-hero__link" href="{{cta2_href}}">{{cta2_label}}</a>{{/cta2_label}}</p>{{/cta_label}}
  </div>
</section>
