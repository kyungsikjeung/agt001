<section class="s-around s-around--map" data-section-id="{{id}}" aria-labelledby="around-title-{{id}}">
  <h2 id="around-title-{{id}}">{{> label}}</h2>
  <div class="s-map">
{{#has_geo}}
    <div class="s-map__live" data-x="{{geo_x}}" data-y="{{geo_y}}" role="img" aria-label="지도: {{address}}"></div>
{{/has_geo}}
    <div class="s-map__art"{{#has_geo}} hidden{{/has_geo}} role="img" aria-label="예시 지도: 실제 지도는 곧 연결돼요">
      <svg viewBox="0 0 400 250" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
        <rect width="400" height="250" class="s-map__land"/>
        <path class="s-map__park" d="M22 150h86v78H22zM300 18h82v64h-82z"/>
        <path class="s-map__water" d="M0 206c60-18 110 10 170-6s120-30 230-8v58H0z"/>
        <g class="s-map__block"><rect x="130" y="24" width="70" height="52" rx="4"/><rect x="214" y="24" width="72" height="52" rx="4"/><rect x="22" y="24" width="94" height="52" rx="4"/><rect x="22" y="92" width="94" height="44" rx="4"/><rect x="214" y="92" width="72" height="72" rx="4"/><rect x="300" y="98" width="82" height="66" rx="4"/><rect x="130" y="150" width="70" height="40" rx="4"/></g>
        <path class="s-map__road" d="M0 84h400M122 0v250M207 0v200M293 0v196M0 142h122"/>
        <path class="s-map__road s-map__road--main" d="M0 176c80 0 120-44 207-44s140 18 193 12"/>
      </svg>
      <span class="s-map__pin" aria-hidden="true"></span>
      <span class="s-illu-badge">예시 지도</span>
    </div>
    <div class="s-map__info">
      <address class="s-around__addr">{{#address}}{{address}}{{/address}}{{^address}}<span class="is-placeholder" aria-label="주소: 아직 입력되지 않음">[주소 입력]</span>{{/address}}</address>
      {{#has_links}}<p class="s-map__links">{{#links}}<a class="s-btn s-btn--ghost" href="{{href}}" target="_blank" rel="noopener noreferrer">{{label}}</a>{{/links}}</p>{{/has_links}}
      {{#has_items}}
      <dl class="s-transit">
        {{#items}}<div class="s-transit__row"><dt>{{name}}</dt><dd>{{#note}}{{note}}{{/note}}{{^note}}<span class="is-placeholder" aria-label="안내: 아직 입력되지 않음">[안내 입력]</span>{{/note}}</dd></div>{{/items}}
      </dl>
      {{/has_items}}
    </div>
  </div>
{{#has_geo}}
  <script src="https://dapi.kakao.com/v2/maps/sdk.js?appkey={{map_key}}&autoload=false"></script>
  <script>(function(){try{
  // 실제 지도 그리기, 3초 안에 SDK가 없으면 예시 지도로 되돌림
  var box=document.querySelector('.s-map__live');if(!box)return;
  var x=parseFloat(box.getAttribute('data-x')),y=parseFloat(box.getAttribute('data-y'));
  function back(){box.hidden=true;var a=box.parentNode.querySelector('.s-map__art');if(a){a.hidden=false;}}
  var t0=Date.now();
  (function wait(){if(window.kakao&&kakao.maps){try{kakao.maps.load(function(){var p=new kakao.maps.LatLng(y,x);var m=new kakao.maps.Map(box,{center:p,level:3,draggable:false});new kakao.maps.Marker({position:p,map:m});});}catch(e){back();}return;}
  if(Date.now()-t0>3000){back();return;}setTimeout(wait,100);})();
  }catch(e){}})();</script>
{{/has_geo}}
</section>
