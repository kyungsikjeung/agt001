<section class="s-features s-features--icons" data-section-id="{{id}}" aria-labelledby="features-title-{{id}}">
  <h2 id="features-title-{{id}}">{{#label}}{{label}}{{/label}}{{^label}}특징{{/label}}</h2>
  {{#has_items}}
  <ul class="s-features__list">
    {{#items}}
    <li class="s-feature">
      <span class="s-feature__icon" aria-hidden="true">{{#icon_star}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3l2.7 5.6 6.1.8-4.5 4.2 1.1 6-5.4-3-5.4 3 1.1-6L3.2 9.4l6.1-.8z"/></svg>{{/icon_star}}{{#icon_pin}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21s-6.5-5.4-6.5-10.4A6.5 6.5 0 0 1 12 4a6.5 6.5 0 0 1 6.5 6.6C18.5 15.6 12 21 12 21z"/><circle cx="12" cy="10.5" r="2.3"/></svg>{{/icon_pin}}{{#icon_clock}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>{{/icon_clock}}{{#icon_phone}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 4h3l1.5 4.5L9 10a12 12 0 0 0 5 5l1.5-2.5L20 14v3a2 2 0 0 1-2 2A15 15 0 0 1 5 6a2 2 0 0 1 2-2z"/></svg>{{/icon_phone}}{{#icon_leaf}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 19C5 9 12 5 20 4c-1 8-5 15-15 15z"/><path d="M5 19c3-5 7-9 11-11"/></svg>{{/icon_leaf}}{{#icon_heart}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7a4.3 4.3 0 0 1 7.5 3c0 5.4-7.5 10-7.5 10z"/></svg>{{/icon_heart}}</span>
      <strong class="s-feature__title">{{#title}}{{title}}{{/title}}{{^title}}<span class="is-placeholder" aria-label="특징 이름: 아직 입력되지 않음">[이름 입력]</span>{{/title}}</strong>
      {{#desc}}<span class="s-feature__desc">{{desc}}</span>{{/desc}}
    </li>
    {{/items}}
  </ul>
  {{/has_items}}
  {{^has_items}}
  <ul class="s-features__list">
    <li class="s-feature"><span class="is-placeholder" aria-label="특징: 아직 입력되지 않음">[특징 입력]</span></li>
  </ul>
  {{/has_items}}
  {{#note}}<p class="s-features__note">{{note}}</p>{{/note}}
</section>
