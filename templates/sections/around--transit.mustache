<section class="s-around s-around--transit" data-section-id="{{id}}" aria-labelledby="around-title-{{id}}">
  <h2 id="around-title-{{id}}">오시는 길</h2>
  <address class="s-around__addr">
    {{#address}}{{address}}{{/address}}{{^address}}<span class="is-placeholder" aria-label="주소: 아직 입력되지 않음">[주소 입력]</span>{{/address}}
  </address>
  {{#map_url}}<p class="s-around__map"><a class="s-btn" href="{{map_url}}" target="_blank" rel="noopener noreferrer">지도로 보기</a></p>{{/map_url}}
  {{#has_items}}
  <dl class="s-transit">
    {{#items}}
    <div class="s-transit__row">
      <dt>{{name}}</dt>
      <dd>{{#note}}{{note}}{{/note}}{{^note}}<span class="is-placeholder" aria-label="교통 안내: 아직 입력되지 않음">[안내 입력]</span>{{/note}}</dd>
    </div>
    {{/items}}
  </dl>
  {{/has_items}}
  {{^has_items}}
  <p><span class="is-placeholder" aria-label="교통 안내: 아직 입력되지 않음">[교통 안내 입력]</span></p>
  {{/has_items}}
</section>
