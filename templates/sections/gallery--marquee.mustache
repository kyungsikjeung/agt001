<section class="s-gallery s-gallery--marquee" data-section-id="{{id}}"{{> gallery-attrs}} aria-labelledby="gallery-title-{{id}}">
  <h2 id="gallery-title-{{id}}">{{> label}}</h2>
  <div class="s-marquee">
    <ul class="s-marquee__track">
      {{#items_twice}}<li{{#repeat}} class="s-marquee__repeat" aria-hidden="true"{{/repeat}}><figure>{{#src}}<img src="{{src}}" alt="{{alt}}" loading="lazy">{{#ai_badge}}<span class="s-illu-badge">AI 예시</span>{{/ai_badge}}{{/src}}{{^src}}{{#title}}<div class="s-cap-tile" aria-hidden="true"></div>{{/title}}{{/src}}{{> caption}}</figure></li>{{/items_twice}}
    </ul>
  </div>
  <p class="s-gallery__notice">좌우로 밀어 볼 수 있어요</p>
</section>
