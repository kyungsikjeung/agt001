<section class="s-gallery s-gallery--marquee" data-section-id="{{id}}" aria-labelledby="gallery-title-{{id}}">
  <h2 id="gallery-title-{{id}}">{{#label}}{{label}}{{/label}}{{^label}}사진첩{{/label}}</h2>
  <div class="s-marquee">
    <ul class="s-marquee__track">
      {{#items_twice}}<li><figure>{{#src}}<img src="{{src}}" alt="{{alt}}" loading="lazy">{{#ai_badge}}<span class="s-illu-badge">AI 예시</span>{{/ai_badge}}{{/src}}{{#caption}}<figcaption>{{caption}}</figcaption>{{/caption}}</figure></li>{{/items_twice}}
    </ul>
  </div>
  <p class="s-gallery__notice">좌우로 밀어 볼 수 있어요</p>
</section>
