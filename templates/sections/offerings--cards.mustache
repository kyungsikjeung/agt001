<section class="s-offerings s-offerings--cards ed-cards" data-section-id="{{id}}" aria-labelledby="offerings-title-{{id}}">
  <h2 class="ed-cards__title" id="offerings-title-{{id}}">{{> label}}</h2>
  {{#has_items}}
  {{#scroll}}<p class="s-cards__hint">옆으로 넘겨 보세요 → ({{count}}개)</p>{{/scroll}}
  <ul class="s-cards ed-cards__grid{{#scroll}} s-cards--scroll{{/scroll}}"{{#scroll}} tabindex="0" aria-label="{{#label}}{{label}} {{/label}}{{count}}개, 옆으로 넘겨 보세요"{{/scroll}}>
    {{#items}}
    <li class="s-card ed-cards__card"{{#item_id}} data-item-id="{{item_id}}"{{/item_id}}{{#price_won}} data-price-won="{{price_won}}"{{/price_won}}>
      {{#image_src}}<figure class="s-card__media"><img src="{{image_src}}" alt="{{image_alt}}">{{#image_ai}}<span class="s-illu-badge">AI 예시</span>{{/image_ai}}{{#image_example}}<span class="s-illu-badge">예시 이미지</span>{{/image_example}}</figure>{{/image_src}}
      {{^image_src}}{{^image_off}}<div class="s-media__empty is-placeholder" aria-label="상품 사진: 아직 입력되지 않음">[사진 입력]</div>{{/image_off}}{{/image_src}}
      <strong class="s-card__name">{{#name}}{{name}}{{/name}}{{^name}}<span class="is-placeholder" aria-label="항목 이름: 아직 입력되지 않음">[이름 입력]</span>{{/name}}</strong>
      {{#desc}}<p class="s-card__desc">{{desc}}</p>{{/desc}}
      <p class="s-card__price">{{#price}}{{price}}{{/price}}{{^price}}<span class="is-placeholder" aria-label="가격: 아직 입력되지 않음">[가격 입력]</span>{{/price}}</p>
      {{#action}}<a class="s-card__action s-card__action--{{kind}}" href="{{href}}" data-action="{{kind}}">{{label}}</a>{{/action}}
      {{#item_id}}<div class="s-card__reviews" data-review-slot="{{item_id}}" hidden></div>{{/item_id}}
    </li>
    {{/items}}
  </ul>
  {{/has_items}}
  {{^has_items}}
  <ul class="s-cards ed-cards__grid">
    <li class="s-card"><span class="is-placeholder" aria-label="상품·메뉴: 아직 입력되지 않음">[메뉴 입력]</span></li>
  </ul>
  {{/has_items}}
</section>
