<section class="s-offerings s-offerings--cards ed-cards" data-section-id="{{id}}" aria-labelledby="offerings-title-{{id}}">
  <h2 class="ed-cards__title" id="offerings-title-{{id}}">{{#label}}{{label}}{{/label}}{{^label}}메뉴{{/label}}</h2>
  {{#has_items}}
  <ul class="s-cards ed-cards__grid">
    {{#items}}
    <li class="s-card ed-cards__card">
      {{#image_src}}<img src="{{image_src}}" alt="{{image_alt}}">{{/image_src}}
      {{^image_src}}<div class="s-media__empty is-placeholder" aria-label="상품 사진: 아직 입력되지 않음">[사진 입력]</div>{{/image_src}}
      <strong class="s-card__name">{{#name}}{{name}}{{/name}}{{^name}}<span class="is-placeholder" aria-label="항목 이름: 아직 입력되지 않음">[이름 입력]</span>{{/name}}</strong>
      {{#desc}}<p class="s-card__desc">{{desc}}</p>{{/desc}}
      <p class="s-card__price">{{#price}}{{price}}{{/price}}{{^price}}<span class="is-placeholder" aria-label="가격: 아직 입력되지 않음">[가격 입력]</span>{{/price}}</p>
    </li>
    {{/items}}
  </ul>
  {{/has_items}}
  {{^has_items}}
  <ul class="s-cards ed-cards__grid">
    <li class="s-card"><span class="is-placeholder" aria-label="상품·메뉴: 아직 입력되지 않음">[메뉴 입력]</span></li>
  </ul>
  {{/has_items}}
</section>
