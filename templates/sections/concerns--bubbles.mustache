<section class="s-concerns s-concerns--bubbles ed-worry" data-section-id="{{id}}" aria-labelledby="concerns-title-{{id}}">
  <h2 id="concerns-title-{{id}}">{{#heading}}{{heading}}{{/heading}}{{^heading}}이런 고민 있으세요?{{/heading}}</h2>
  {{#has_items}}
  <ul class="ed-worry__list">
    {{#items}}
    <li class="ed-worry__bubble">
      <p class="ed-worry__quote">{{quote}}</p>
      {{#who}}<p class="ed-worry__who">{{who}}</p>{{/who}}
    </li>
    {{/items}}
  </ul>
  {{/has_items}}
  {{^has_items}}
  <p>상담에서 자주 듣는 질문을 여기에 적어 드립니다.</p>
  {{/has_items}}
  {{#note}}<p class="ed-worry__note">{{note}}</p>{{/note}}
</section>
