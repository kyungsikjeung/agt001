<section class="s-staff s-staff--team" data-section-id="{{id}}" aria-labelledby="staff-title-{{id}}">
  <h2 id="staff-title-{{id}}">{{> label}}</h2>
  <ul class="s-staff__row">
    {{#members}}
    <li class="s-staff__card">
      <div class="s-staff__head">
        {{#image_src}}<img class="s-staff__avatar" src="{{image_src}}" alt="{{image_alt}}" loading="lazy">{{/image_src}}
        {{^image_src}}<span class="s-staff__avatar s-staff__avatar--mono" aria-hidden="true">{{initial}}</span>{{/image_src}}
        <p class="s-staff__who"><strong class="s-staff__name">{{name}}</strong>{{#role}}<span class="s-staff__role">{{role}}</span>{{/role}}{{#example}}<span class="s-example">예시</span>{{/example}}{{^example}}{{#image_example}}<span class="s-example s-example--keep">예시 사진</span>{{/image_example}}{{/example}}</p>
      </div>
      {{#has_specialties}}<ul class="s-tags" aria-label="{{name}} 전문 분야">{{#specialties}}<li>{{text}}</li>{{/specialties}}</ul>{{/has_specialties}}
      {{#bio}}<p class="s-staff__bio">{{bio}}</p>{{/bio}}
      {{#booking_href}}<a class="s-btn s-btn--ghost s-btn--block" href="{{booking_href}}">{{name}} {{#role}}{{role}}{{/role}}에게 예약</a>{{/booking_href}}
    </li>
    {{/members}}
  </ul>
</section>
