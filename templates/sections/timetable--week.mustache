<section class="s-timetable s-timetable--week" data-section-id="{{id}}" aria-labelledby="timetable-title-{{id}}">
  <h2 id="timetable-title-{{id}}">{{> label}}{{#example}} <span class="s-example" title="예시 시간표: 공개할 때 빠져요">예시</span>{{/example}}</h2>
  {{#has_rows}}
  <div class="s-timetable__scroll">
    <table class="s-timetable__table">
      <caption>{{> label}}</caption>
      <thead>
        <tr><th scope="col">시간</th>{{#days}}<th scope="col">{{label}}</th>{{/days}}</tr>
      </thead>
      <tbody>
        {{#rows}}
        <tr><th scope="row">{{time}}</th>{{#cells}}<td>{{#text}}{{text}}{{/text}}</td>{{/cells}}</tr>
        {{/rows}}
      </tbody>
    </table>
  </div>
  {{/has_rows}}
  {{^has_rows}}
  <p><span class="is-placeholder" aria-label="시간표: 아직 입력되지 않음">[시간표 입력]</span></p>
  {{/has_rows}}
</section>
