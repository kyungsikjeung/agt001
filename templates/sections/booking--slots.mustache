<section class="s-booking s-booking--slots" data-section-id="{{id}}" aria-labelledby="booking-title-{{id}}">
  <h2 id="booking-title-{{id}}">{{#label}}{{label}}{{/label}}{{^label}}예약{{/label}}</h2>
  {{#note}}<p class="s-booking__note">{{note}}</p>{{/note}}
  <form class="s-form" method="post" action="/api/bookings/{{site_key}}" enctype="application/x-www-form-urlencoded">
    {{#has_staff}}
    <fieldset class="s-form__row s-pick">
      <legend>누구에게 받으실까요?</legend>
      <div class="s-pick__opts">
        <input class="s-pick__in" type="radio" id="booking-staff-{{id}}-0" name="staff" value="" checked><label class="s-pick__chip" for="booking-staff-{{id}}-0">상관없음</label>
        {{#staff}}<input class="s-pick__in" type="radio" id="booking-staff-{{id}}-{{index}}" name="staff" value="{{name}}"><label class="s-pick__chip" for="booking-staff-{{id}}-{{index}}">{{name}}</label>{{/staff}}
      </div>
    </fieldset>
    {{/has_staff}}
    {{#has_services}}
    <p class="s-form__row">
      <label for="booking-service-{{id}}">{{service_label}} (선택)</label>
      <select id="booking-service-{{id}}" name="service">
        <option value="">선택 안 함</option>
        {{#services}}<option value="{{name}}">{{name}}</option>{{/services}}
      </select>
    </p>
    {{/has_services}}
    {{#has_days}}
    <fieldset class="s-form__row s-slots">
      <legend>날짜와 시간 (필수){{#days_example}} <span class="s-example">예시 현황</span>{{/days_example}}</legend>
      <p class="s-slots__legend" aria-hidden="true"><span class="s-dot s-dot--open"></span>여유 <span class="s-dot s-dot--few"></span>마감 임박 <span class="s-dot s-dot--full"></span>마감</p>
      {{#days}}
      <div class="s-slots__day">
        <p class="s-slots__date"><strong>{{label}}</strong> {{dow}}</p>
        <div class="s-slots__times">
          {{#slots}}<input class="s-pick__in" type="radio" id="slot-{{id}}-{{key}}" name="slot" value="{{value}}" required{{#is_full}} disabled{{/is_full}}><label class="s-slot s-slot--{{state}}" for="slot-{{id}}-{{key}}"><span class="s-slot__time">{{time}}</span><span class="s-slot__state">{{state_label}}</span></label>{{/slots}}
        </div>
      </div>
      {{/days}}
      {{#days_example}}<p class="s-form__hint">시안에는 예시 현황이 보여요. 공개하면 확정된 예약으로 계산돼요.</p>{{/days_example}}
    </fieldset>
    {{/has_days}}
    {{^has_days}}
    <p class="s-form__row">
      <label for="booking-date-{{id}}">방문일 (필수)</label>
      <input id="booking-date-{{id}}" name="date" type="date" required>
    </p>
    <p class="s-form__row">
      <label for="booking-time-{{id}}">희망 시간 (선택)</label>
      <input id="booking-time-{{id}}" name="time" type="time">
    </p>
    {{/has_days}}
    <p class="s-form__row">
      <label for="booking-name-{{id}}">이름 (선택)</label>
      <input id="booking-name-{{id}}" name="name" type="text" maxlength="40" autocomplete="name">
    </p>
    <p class="s-form__row">
      <label for="booking-phone-{{id}}">연락처 (필수)</label>
      <input id="booking-phone-{{id}}" name="phone" type="tel" maxlength="20" autocomplete="tel" required>
    </p>
    <p class="s-form__row">
      <label for="booking-memo-{{id}}">요청 사항 (선택)</label>
      <textarea id="booking-memo-{{id}}" name="memo" rows="3" maxlength="300"></textarea>
    </p>
    <p class="s-form__notice">예약 정보는 방문일 뒤 {{retention_days}}일 보관 후 삭제합니다.</p>
    <p class="s-form__row s-form__agree">
      <input id="booking-agree-{{id}}" name="agree" type="checkbox" value="yes" required>
      <label for="booking-agree-{{id}}">개인정보 수집·이용에 동의합니다 (필수)</label>
    </p>
    <p class="s-form__hp" aria-hidden="true">
      <label for="booking-website-{{id}}">웹사이트는 비워 두세요</label>
      <input id="booking-website-{{id}}" name="website" type="text" tabindex="-1" autocomplete="off">
    </p>
    <p class="s-form__submit"><button class="s-btn s-btn--block" type="submit">예약 신청하기</button></p>
  </form>
</section>
