(function(){try{
// 실제 지도 그리기 (MAP_CONTRACT §4). SDK가 4초 안에 안 오거나, 불러온 뒤 5초 안에 못 그리면 예시 지도로 되돌린다(빈 칸 방지).
var boxes=[].slice.call(document.querySelectorAll('.s-map__live[data-x]:not([data-map])'));if(!boxes.length)return;
boxes.forEach(function(b){b.setAttribute('data-map','wait')});
function back(b){if(b.getAttribute('data-map')==='ok')return;b.setAttribute('data-map','fail');b.hidden=true;var a=b.parentNode&&b.parentNode.querySelector('.s-map__art');if(a){a.hidden=false}}
function draw(b){try{var x=parseFloat(b.getAttribute('data-x')),y=parseFloat(b.getAttribute('data-y'));var p=new kakao.maps.LatLng(y,x);var m=new kakao.maps.Map(b,{center:p,level:3,draggable:false});new kakao.maps.Marker({position:p,map:m});b.setAttribute('data-map','ok')}catch(e){back(b)}}
var t0=Date.now();
(function wait(){if(window.kakao&&kakao.maps&&kakao.maps.load){try{kakao.maps.load(function(){boxes.forEach(draw)})}catch(e){boxes.forEach(back);return}setTimeout(function(){boxes.forEach(back)},5000);return}
if(Date.now()-t0>4000){boxes.forEach(back);return}setTimeout(wait,100)})();
}catch(e){}})();
