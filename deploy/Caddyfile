# 144.24.91.250.sslip.io 로 들어오는 HTTPS를 Flask(backend:8643)로 전달한다.
# Let's Encrypt 인증서는 Caddy가 자동 발급/갱신한다(80/443 포트 개방 필요).
144.24.91.250.sslip.io {
	reverse_proxy backend:8643
}

# 생성 사이트·시안 전용 주소 (S-1). 같은 백엔드로 보내고, 백엔드가 주소를 보고 생성물만 연다(app/main.py _split_hosts).
144-24-91-250.sslip.io {
	reverse_proxy backend:8643
}
