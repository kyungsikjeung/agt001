{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "deploy_to_review.schema.json",
  "title": "BND-5: 배포(병렬작업 3) → 사람 최종 검토(⑱). 병렬작업 2로 직접 가지 않는다",
  "type": "object",
  "required": ["requirement_id", "status"],
  "properties": {
    "requirement_id": { "type": "string" },
    "deploy_url": { "type": "string", "format": "uri", "description": "status가 ready일 때만 존재" },
    "status": { "type": "string", "enum": ["ready", "failed"] }
  },
  "additionalProperties": true
}
