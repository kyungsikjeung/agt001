{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "quote_to_design.schema.json",
  "title": "BND-2: 견적(팀원 A) → 시안생성(팀원 B)",
  "type": "object",
  "required": ["requirement_id", "platform", "features", "quote"],
  "properties": {
    "requirement_id": { "type": "string" },
    "platform": { "type": "string", "enum": ["web", "android"] },
    "features": {
      "type": "array",
      "items": { "type": "string" },
      "description": "시안에 반영할 핵심 기능 목록"
    },
    "quote": {
      "type": "object",
      "required": ["amount", "basis"],
      "properties": {
        "amount": { "type": "number", "description": "견적 금액(원)" },
        "basis": { "type": "string", "description": "산정 근거 문구, 시안 페이지에 그대로 노출됨" }
      }
    }
  },
  "additionalProperties": true
}
