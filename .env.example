# 복사해서 .env로 쓰세요: cp .env.example .env  (.env는 .gitignore에 있어야 하며 절대 커밋하지 않습니다)
# 값 발급처와 용도는 docs/hackathon/deployment/RENDER_DEPLOY.md §3-3 표를 참고하세요.

# NVIDIA NIM
NIM_API_KEY=
NIM_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
NIM_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# RAG 벡터DB (Pinecone 등)
VECTOR_DB_URL=
VECTOR_DB_API_KEY=

# 카카오링크
KAKAO_LINK_API_KEY=

# 로컬 개발용 (Render 배포 시 PORT는 자동 주입되므로 여기서 지정하지 않음)
PORT=8643

# PostgreSQL (compose db 서비스·backend DATABASE_URL용).
# 서버 .env에 실제 값을 넣는다. 비워 두면 compose가 기동 시 오류로 알려준다.
# 로컬 개발용으로는 임의의 값을 넣으면 된다 (예: openssl rand -hex 24).
POSTGRES_PASSWORD=

# Hermes 게이트웨이 연동용 (별도 프로세스, 스캐폴딩만 — backend.py는 현재 NIM 직접 호출 유지)
# NemoClaw+Hermes 설치 후 플래너 API가 http://127.0.0.1:8642/v1 에 뜨면 backend.py가 이 URL을 참조하도록 전환 예정.
# backend.py의 8643과 충돌 없음 (8642=Hermes API, 9119=Hermes 대시보드).
HERMES_GATEWAY_URL=http://127.0.0.1:8642/v1
