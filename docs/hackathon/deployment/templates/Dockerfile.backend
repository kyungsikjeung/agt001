FROM python:3.11-slim

# 팀C(코드생성) 격리용: backend 컨테이너 자신은 Docker 데몬을 갖고 있지 않으므로,
# 호스트의 데몬을 docker.sock으로 빌려 쓰는 "Docker-outside-of-Docker" 구조다.
# 이 CLI는 그 소켓에 명령만 보내는 클라이언트이고, 실제 실행은 호스트 데몬이 한다.
# 실측(Debian trixie/13): docker.io 패키지가 데몬(dockerd)만 담고, CLI 바이너리
# (/usr/bin/docker)는 별도 docker-cli 패키지로 분리돼 있다 — docker.io만 설치하면
# `shutil.which("docker")`가 실패해 팀C 코드생성이 "docker가 없다"며 건너뛰어진다.
RUN apt-get update \
    && apt-get install -y --no-install-recommends docker.io docker-cli \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 팀B(UI 시안) 카카오 미리보기 이미지용: 렌더링된 시안 HTML을 헤드리스 브라우저로
# 스크린샷 찍는다(render_design() 참고). --with-deps로 Chromium 실행에 필요한
# OS 라이브러리(폰트/코덱 등)까지 같이 설치한다.
RUN python -m playwright install --with-deps chromium

COPY . .

# Render가 런타임에 PORT 환경변수를 주입한다. backend.py는 이 값을 읽어 바인딩해야 한다.
ENV PORT=8643
EXPOSE 8643

# Caddy가 넘겨준 X-Forwarded-Proto를 신뢰해 배포 URL이 https로 나오게 한다.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8643", "--proxy-headers", "--forwarded-allow-ips", "*"]
